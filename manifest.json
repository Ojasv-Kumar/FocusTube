{
  "manifest_version": 3,
  "name": "FocusTube",
  "version": "3.0.0",
  "description": "Make YouTube intentional, useful, and calm.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "FocusTube",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https:"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/loader.js",
        "src/content/focustube.bundle.js",
        "src/content/attention.js"
      ],
      "css": [
        "src/content/hide.css"
      ],
      "run_at": "document_start"
    }
  ]
}
